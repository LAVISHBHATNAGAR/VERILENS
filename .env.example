# ==============================================================================
# VERILENS — Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard)
# ------------------------------------------------------------------------------
# Port is automatically assigned by Render at runtime. Fallback is 3001.
PORT=3001
NODE_ENV=production

# Maximum image upload size in Megabytes (default 15MB)
MAX_FILE_SIZE_MB=15

# Allowed CORS Origins (comma-separated).
# https://verilens-alpha.vercel.app and localhost are permitted by default.
ALLOWED_ORIGINS=https://verilens-alpha.vercel.app,http://localhost:5173,http://localhost:4173

# (Optional) Pretrained Vision Transformer / Hugging Face Inference API
# Get a free read token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# (Optional) Sightengine GenAI API
# https://sightengine.com/
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# (Optional) Hive Moderation Deepfake Detection API
# https://thehive.ai/
HIVE_API_KEY=

# (Optional) Custom PyTorch / FastAPI Detection Node URL
CUSTOM_DETECTION_API_URL=

# ------------------------------------------------------------------------------
# 2. VERCEL FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# ------------------------------------------------------------------------------
# The public HTTPS URL of your deployed Render Web Service (no trailing slash).
# Example: https://verilens-backend.onrender.com
VITE_API_URL=
